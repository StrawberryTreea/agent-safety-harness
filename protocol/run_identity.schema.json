{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RunIdentity",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "run_identity_v1"
    },
    "track": {
      "enum": [
        "llm_qa",
        "agent_execution",
        "agent_product",
        "trace_judge"
      ]
    },
    "inputs_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "effective_prompt_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "target_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "environment_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "scorer_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "dataset_version": {
      "type": "string",
      "minLength": 1
    },
    "seed": {
      "type": "integer"
    },
    "identity_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "required": [
    "schema_version",
    "track",
    "inputs_hash",
    "effective_prompt_hash",
    "target_hash",
    "environment_hash",
    "scorer_hash",
    "dataset_version",
    "seed",
    "identity_hash"
  ]
}
