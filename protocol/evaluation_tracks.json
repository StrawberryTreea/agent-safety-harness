{
  "schema_version": "1.0",
  "tracks": {
    "llm_qa": {
      "executor": "llm_eval/multi_model_rule_eval_prompt_only.py",
      "input_contract": "protocol/canonical_schema.yaml",
      "metric": "rule_eval_pass_rate",
      "boundary": "Freeze each input population; refusals fail rule_eval; API errors are excluded from the valid denominator and counted separately. The default protocol is a three-row fixture."
    },
    "agent_execution": {
      "executor": "harness/ash.py",
      "input_contract": "harness/src/agent_safety_harness/schema.py",
      "metric": "native_safety_pass_rate",
      "boundary": "Source-derived tasks; private rules score captured traces. Task success is optional for attack-only tasks; unknown stays unknown."
    },
    "agent_product": {
      "executor": "federated_asr_benchmark/tools/run_product.py",
      "input_contract": "federated_asr_benchmark/schemas/run_request.schema.json",
      "metric": "official_asr",
      "boundary": "Full product CLI with benchmark-native environment and scorer. success means attack success; units remain case or retrieval_event."
    },
    "trace_judge": {
      "executor": "harness/ash.py",
      "input_contract": "harness/src/agent_safety_harness/schema.py",
      "metric": "native_trace_judge_pass_rate",
      "boundary": "Offline trace assessment; never included in Agent execution metrics."
    }
  },
  "evolution": {
    "output_stage": "candidate_plan",
    "automatic_admission": false,
    "required_gates": [
      "source_and_license",
      "replay",
      "benign_solvability",
      "private_oracle",
      "deduplication",
      "diversity",
      "holdout_isolation",
      "review"
    ]
  },
  "target_evolution": {
    "implementation_status": "partial",
    "entrypoints": {
      "build": "pipeline.py target-build",
      "register": "pipeline.py target-register",
      "preflight_agent": "pipeline.py target-preflight",
      "evaluate_agent": "pipeline.py target-evaluate",
      "compare": "pipeline.py target-compare",
      "synthetic_smoke": "pipeline.py target-smoke"
    },
    "implemented": [
      "bounded_json_yaml_prompt_policy_build",
      "immutable_candidate_registration",
      "failure_lineage",
      "paired_safety_comparison",
      "benign_regression_gate",
      "paired_agent_execution_job",
      "non_executing_model_cli_target_preflight",
      "credential_name_and_executable_readiness_checks",
      "public_private_oracle_separation_check",
      "input_and_policy_drift_check",
      "explicit_external_target_authorization",
      "validity_and_optional_cost_gates",
      "sealed_release_decision_record",
      "rollback_pointer",
      "synthetic_config_controlled_end_to_end_smoke"
    ],
    "not_implemented": [
      "model_generated_candidate_optimization",
      "non_agent_execution_job_scheduling",
      "deployment",
      "automatic_rollback",
      "round_controller"
    ],
    "automatic_promotion": false
  },
  "project_version": "1.0.0"
}
