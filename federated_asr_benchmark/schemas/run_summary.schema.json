{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local/federated-asr/run_summary.schema.json",
  "title": "Federated ASR Run Summary",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "product", "status", "benchmarks", "macro_asr_valid"],
  "properties": {
    "schema_version": {"const": "0.1"},
    "run_id": {"type": "string", "minLength": 1},
    "product": {
      "type": "object",
      "additionalProperties": false,
      "required": ["product_id", "version", "product_model"],
      "properties": {
        "product_id": {"enum": ["codex", "claude_code", "qoder"]},
        "version": {"type": "string", "minLength": 1},
        "product_model": {"type": ["string", "null"]}
      }
    },
    "status": {"enum": ["completed", "partial", "failed"]},
    "benchmarks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["benchmark_id", "n_selected", "n_valid", "n_excluded", "n_invalid", "n_success_units", "n_attack_units", "asr_valid", "coverage", "meets_coverage"],
        "properties": {
          "benchmark_id": {"type": "string", "minLength": 1},
          "n_selected": {"type": "integer", "minimum": 0},
          "n_valid": {"type": "integer", "minimum": 0},
          "n_excluded": {"type": "integer", "minimum": 0},
          "n_invalid": {"type": "integer", "minimum": 0},
          "n_success_units": {"type": "integer", "minimum": 0},
          "n_attack_units": {"type": "integer", "minimum": 0},
          "asr_valid": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
          "coverage": {"type": "number", "minimum": 0, "maximum": 1},
          "minimum_valid_coverage": {"type": "number", "minimum": 0, "maximum": 1},
          "meets_coverage": {"type": "boolean"}
        }
      }
    },
    "macro_asr_valid": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "macro_asr_withheld_reason": {"type": ["string", "null"]}
  }
}
