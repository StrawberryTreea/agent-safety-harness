{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local/product-federated-asr/product_run.schema.json",
  "title": "Product-Native Case Execution",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "benchmark_id", "case_id", "product", "status", "command", "started_at", "duration_seconds", "returncode", "timed_out", "final_response", "stdout_file", "stderr_file", "final_response_file", "state_source", "isolated_state_dir", "isolated_state_removed", "error"],
  "properties": {
    "schema_version": {"const": "0.1"},
    "run_id": {"type": "string", "minLength": 1},
    "benchmark_id": {"type": "string", "minLength": 1},
    "case_id": {"type": "string", "minLength": 1},
    "product": {
      "type": "object",
      "additionalProperties": false,
      "required": ["product_id", "version", "product_model"],
      "properties": {
        "product_id": {"enum": ["codex", "claude_code", "qoder"]},
        "version": {"type": "string", "minLength": 1},
        "product_model": {"type": ["string", "null"]}
      }
    },
    "status": {"enum": ["dry_run", "completed", "failed"]},
    "command": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "started_at": {"type": "string", "format": "date-time"},
    "duration_seconds": {"type": "number", "minimum": 0},
    "returncode": {"type": ["integer", "null"]},
    "timed_out": {"type": "boolean"},
    "final_response": {"type": "string"},
    "stdout_file": {"type": "string"},
    "stderr_file": {"type": "string"},
    "final_response_file": {"type": "string"},
    "state_source": {"type": ["string", "null"]},
    "isolated_state_dir": {"type": "string", "minLength": 1},
    "isolated_state_removed": {"type": "boolean"},
    "error": {"type": ["string", "null"]}
  }
}
